# ─────────────────────────────────────────────
# Copy this to terraform.tfvars and fill in
# your real values. Never commit tfvars!
# ─────────────────────────────────────────────

# Choose one: aws | azure | gcp
cloud_provider = "aws"

project_name = "multicloud-vpn"
environment  = "dev"

# Region format depends on the provider:
#   AWS   → "us-east-1"
#   Azure → "East US"
#   GCP   → "us-central1"
region = "us-east-1"

# ─────────────────────────────────────────────
# VPN settings (required for all modes)
# ─────────────────────────────────────────────
on_prem_gateway_ip = "203.0.113.10"   # Your on-prem device public IP
on_prem_cidr       = "192.168.0.0/24"
shared_key         = "CHANGE_ME_strong_psk"

# ─────────────────────────────────────────────
# MODE A — Create new VPC + VPN (default)
# use_existing_vpc = false
# ─────────────────────────────────────────────
use_existing_vpc = false
vpn_cidr         = "10.0.0.0/16"     # New VPC CIDR (ignored in existing-VPC mode)

# ─────────────────────────────────────────────
# MODE B — Attach VPN to existing VPC/VNet
# Uncomment and fill in the block for your cloud
# ─────────────────────────────────────────────
# use_existing_vpc = true

# ── AWS existing VPC ──────────────────────────
# aws_vpc_id          = "vpc-0abc123456789"
# aws_route_table_ids = ["rtb-0abc123", "rtb-0def456"]

# ── Azure existing VNet ───────────────────────
# azure_resource_group_name = "my-existing-rg"
# azure_gateway_subnet_id   = "/subscriptions/.../subnets/GatewaySubnet"

# ── GCP existing VPC ──────────────────────────
# gcp_network_name = "my-existing-vpc"

# ─────────────────────────────────────────────
# Cloud credentials
# ─────────────────────────────────────────────

# AWS (or use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars)
aws_access_key = ""
aws_secret_key = ""

# Azure (or use ARM_* env vars)
azure_subscription_id = ""
azure_tenant_id       = ""
azure_client_id       = ""
azure_client_secret   = ""

# GCP (or use GOOGLE_APPLICATION_CREDENTIALS env var)
gcp_project_id       = ""
gcp_credentials_file = "~/.gcp/service-account.json"
